{
  "name": "raetsel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8788",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply raetsel --local",
    "db:migrate:remote": "wrangler d1 migrations apply raetsel --remote",
    "seed:legacy": "node scripts/seed-from-legacy.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
